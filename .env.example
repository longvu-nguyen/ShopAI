# Database Configuration
POSTGRES_DB=shopai_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection String
CONNECTION_STRING=Host=localhost;Port=5432;Database=shopai_db;Username=postgres;Password=postgrespassword;

# JWT Authentication
JWT_KEY=ShopAI_SuperSecret_Jwt_SigningKey_2026_MustBeLongEnough_32BytesOrMore!
JWT_ISSUER=ShopAI
JWT_AUDIENCE=ShopAIClient
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# Optional External AI Provider (OpenAI / Gemini)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
